									"});",
									"",
									"pm.test(\"<m:IsValidISBN10Response> has correct namespace\", function () {",
									"    pm.expect(parsedXml['soap:Envelope']['soap:Body']['m:IsValidISBN10Response'].$['xmlns:m']).to.equal(\"http://webservices.daehosting.com/ISBN\");",
									"});",
									"",
									"pm.test(\"Response doesn’t contain unexpected tags\", function () {",
									"    pm.expect(parsedXml['soap:Envelope']['soap:Body']['UnexpectedTag']).to.not.exist;",
									"});",
									"",
									"pm.test(\"Response encoding is UTF-8\", function () {",
									"    pm.expect(pm.response.text().includes('<?xml version=\"1.0\" encoding=\"utf-8\"?>')).to.be.true;",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"type": "text",
								"value": "text/xml; charset=utf-8"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN10 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>0-19-852663-6</sISBN>\n    </IsValidISBN10>\n  </soap:Body>\n</soap:Envelope>"
						},
						"url": {
							"raw": "http://webservices.daehosting.com/services/isbnservice.wso",
							"protocol": "http",
							"host": [
								"webservices",
								"daehosting",
								"com"
							],
							"path": [
								"services",
								"isbnservice.wso"
							]
						},
						"description": "The test is done by calculation on the first 9 digits and compare the result with the checksum number at the end. You have to pass a 10 digits number or 8 digits and an X."
					},
					"response": []
				}
