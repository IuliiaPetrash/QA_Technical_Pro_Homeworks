									"});",
									"",
									"pm.test(\"<soap:Envelope> has correct namespace\", function () {",
									"    pm.expect(parsedXml['soap:Envelope'].$['xmlns:soap']).to.equal(\"http://schemas.xmlsoap.org/soap/envelope/\");",
									"});",
									"",
									"pm.test(\"<m:IsValidISBN10Result> tag exists\", function () {",
									"    pm.expect(parsedXml['soap:Envelope']['soap:Body']['m:IsValidISBN10Response']['m:IsValidISBN10Result']).to.exist;",
									"});",
									"",
									"pm.test(\"<m:IsValidISBN10Result> value is 'true'\", function () {",
