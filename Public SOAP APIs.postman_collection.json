	},
	"item": [
		{
			"name": "Book ISBN Numbers",
			"item": [
				{
					"name": "Is Valid ISBN13 Number",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const xml2js = require('xml2js');",
									"",
									"let parsedXml;",
									"",
									"xml2js.parseString(pm.response.text(), { explicitArray: false }, (err, result) => {",
									"    if (err) {",
									"        console.error(\"Error parsing XML with xml2js\");",
									"    } else {",
									"        parsedXml = result;",
									"    }",
									"});",
									"$ = cheerio.load(pm.response.text(), { xmlMode: true });",
									"",
									"",
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Content-Type is text/xml\", function () {",
									"    pm.response.headers.has('Content-Type', 'text/xml');",
									"});",
									"",
									"pm.test(\"Response contains <soap:Envelope> tag\", function () {",
									"    pm.expect($('soap\\\\:Envelope').length).to.be.greaterThan(0);",
									"});",
									"",
									"pm.test(\"Response contains <soap:Body> tag\", function () {",
									"    pm.expect($('soap\\\\:Body').length).to.be.greaterThan(0);",
									"});",
									"",
									"pm.test(\"<soap:Envelope> has correct namespace\", function () {",
									"    pm.expect($('soap\\\\:Envelope').attr('xmlns:soap')).to.equal(\"http://schemas.xmlsoap.org/soap/envelope/\");",
									"});",
									"",
									"pm.test(\"<m:IsValidISBN13Result> tag exists\", function () {",
									"    pm.expect(parsedXml['soap:Envelope']['soap:Body']['m:IsValidISBN13Response']['m:IsValidISBN13Result']).to.exist;",
									"});",
									"",
									"pm.test(\"<m:IsValidISBN13Result> value is 'true'\", function () {",
									"    const result = parsedXml['soap:Envelope']['soap:Body']['m:IsValidISBN13Response']['m:IsValidISBN13Result'];",
									"    pm.expect(result).to.equal(\"true\");",
									"});",
									"",
									"pm.test(\"<m:IsValidISBN13Response> has correct namespace\", function () {",
									"    pm.expect($('m\\\\:IsValidISBN13Response').attr('xmlns:m')).to.equal(\"http://webservices.daehosting.com/ISBN\");",
									"});",
									"",
									"pm.test(\"Response doesn’t contain unexpected tags\", function () {",
									"    const unexpectedTag = $('UnexpectedTag').length;",
									"    pm.expect(unexpectedTag).to.equal(0);",
									"});",
									"",
									"pm.test(\"Response encoding is UTF-8\", function () {",
									"    pm.expect(responseBody.includes('<?xml version=\"1.0\" encoding=\"utf-8\"?>')).to.be.true;",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"type": "text",
								"value": "text/xml; charset=utf-8"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-1-4612-9090-2</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
						},
						"url": {
							"raw": "http://webservices.daehosting.com/services/isbnservice.wso",
							"protocol": "http",
							"host": [
								"webservices",
								"daehosting",
								"com"
							],
							"path": [
								"services",
								"isbnservice.wso"
							]
						},
						"description": "The test is done by calculation on the first 12 digits and compare the result with the checksum number at the end. You have to pass a 13 digits number."
					},
					"response": []
				},
				{
					"name": "Is Valid ISBN10 Number",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const xml2js = require('xml2js');",
									"",
									"let parsedXml;",
									"",
									"xml2js.parseString(pm.response.text(), { explicitArray: false }, (err, result) => {",
