{
	"info": {
		"_postman_id": "43e2f63e-f654-46c6-802c-0b0ff2f33273",
		"name": "Ukrainian_Cities_QraphQL",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "34258929"
	},
	"item": [
		{
			"name": "get_All_Cities",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const allCities = pm.response.json().data.getAllCities;",
							"",
							"const totalSquare = allCities.reduce((sum, city) => sum + city.square, 0);",
							"const averageSquare = totalSquare / 25;",
							"",
							"pm.collectionVariables.set(\"averageSquare\", averageSquare);",
							"",
							"console.log(averageSquare);",
							"",
							"function getRandomIds(arr, count) {",
							"    let result = [];",
							"    while (result.length < count) {",
							"        const randomIndex = Math.floor(Math.random() * arr.length);",
							"        const id = parseInt(arr[randomIndex].id); ",
							"        if (!result.includes(id)) {",
							"            result.push(id);",
							"        }",
							"    }",
							"    return result.sort((a, b) => a - b); ",
							"}    ",
							"",
							"const randomIds = getRandomIds(allCities, 4);",
							"pm.collectionVariables.set(\"randomId1\", randomIds[0]);",
							"pm.collectionVariables.set(\"randomId2\", randomIds[1]);",
							"pm.collectionVariables.set(\"randomId3\", randomIds[2]);",
							"pm.collectionVariables.set(\"randomId4\", randomIds[3]);",
							"",
							"console.log(randomIds);",
							"",
							"",
							"pm.test(\"Body matches string\", function () {",
							"\tpm.expect(pm.response.text()).to.include(\"square\");",
							"})",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "query{\n    getAllCities{\n      id\n      name\n      square\n\n    }\n}",
						"variables": "{\n\t\"url\": \"https://graphql-ukrainian-cities.hillel.it/graphql\"\n}"
					}
				},
				"url": {
					"raw": "{{url}}",
					"host": [
						"{{url}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "get_randomCities_Description",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"   pm.test(\"Body matches string\", function () {",
							"\tpm.expect(pm.response.text()).to.include(\"description\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "fragment citiesDescription on City{\n    id\n\tname\n    square\n\tdescription\n}\n\nquery{\n\tgetCitiesByIds(in:[{{randomId1}},{{randomId2}},{{randomId3}},{{randomId4}}]){\n        ...citiesDescription\n\t},\n\n\tgetCityByRangeId(filter:{minId:{{randomId1}}, maxId:{{randomId4}}}){\n\t\tid\n\t\tname\n\t\tsquare\n\t}   \n}    ",
						"variables": ""
					}
				},
				"url": {
					"raw": "{{url}}",
					"host": [
						"{{url}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Create_City",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.collectionVariables.set(\"body\", pm.response.text());",
							"var jsonData = pm.response.json();",
							"",
							"pm.test(\"Body is string\", function () {",
							"  var body = pm.collectionVariables.get(\"body\");",
							"  pm.expect(body).to.be.a('string');",
							"});",
							"",
							"pm.test(\"CityId\", function () {",
							"\tpm.expect(jsonData.data.addCity.id).to.eql(\"26\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "mutation{\n    addCity(name:\"{{$randomCity}}\",square:{{averageSquare}},description:\"{{$randomLoremSentences}}\"){\n        id\n        name\n        square\n             ... on City{\n                description\n             }\n    }\n}",
						"variables": ""
					}
				},
				"url": {
					"raw": "{{url}}",
					"host": [
						"{{url}}"
					]
				}
			},
			"response": []
		}
	],
